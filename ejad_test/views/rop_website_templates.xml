<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add a view for  ROP website page. -->
    <template id="rop_website_page" name="ROP Products">
        <t t-call="website.layout">
            <t t-set="additional_title">ROP Products</t>

            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="mb-1">ROP Products</h1>
                            <p class="text-muted mb-0">Products with ROP Count less than 5</p>
                        </div>
                        <span class="badge text-bg-secondary fs-6">
                            <t t-esc="len(products)"/> Product(s)
                        </span>
                    </div>

                    <div t-if="products" class="row g-4">
                        <t t-foreach="products" t-as="product">
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="card h-100 shadow-sm">
                                    <a t-att-href="product.website_url or '#'" class="text-decoration-none">
                                        <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                                             t-att-alt="product.name"
                                             class="card-img-top p-3"
                                             style="height: 230px; object-fit: contain;"/>
                                    </a>

                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">
                                            <a t-att-href="product.website_url or '#'"
                                               class="text-decoration-none text-reset">
                                                <t t-esc="product.name"/>
                                            </a>
                                        </h5>

                                        <div class="mt-auto pt-3">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">ROP Count</span>
                                                <strong t-esc="product.rop_count"/>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <span class="text-muted">Quantity On Hand</span>
                                                <strong t-esc="product.qty_available"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div t-else="" class="alert alert-info text-center my-5" role="alert">
                        No products currently have ROP Count less than 5.
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
