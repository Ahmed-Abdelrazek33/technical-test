<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add a view for  ROP website page. -->
    <template id="rop_website_page" name="ROP Products">
        <t t-call="website.layout">
            <t t-set="additional_title">ROP Products</t>

            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="mb-1">ROP Products</h1>
                            <p class="text-muted mb-0">Products with ROP Count less than 5</p>
                        </div>
                        <span class="badge text-bg-secondary fs-6">
                            <t t-esc="len(products)"/> Product(s)
                        </span>
                    </div>

                    <div t-if="products" class="row g-4">
                        <t t-foreach="products" t-as="product">
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="card h-100 shadow-sm">
                                    <a t-att-href="product.website_url or '#'" class="text-decoration-none">
                                        <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                                             t-att-alt="product.name"
                                             class="card-img-top p-3"
                                             style="height: 230px; object-fit: contain;"/>
                                    </a>

                                    <div class="px-3 pb-2">
                                        <button type="button" class="btn btn-primary btn-sm w-100"
                                                data-bs-toggle="modal"
                                                t-att-data-bs-target="'#qty_modal_%s' % product.id">
                                            Update Product quantity
                                        </button>
                                    </div>
                                    <div class="modal fade" t-attf-id="qty_modal_#{product.id}" tabindex="-1">
                                        <div class="modal-dialog">
                                            <form class="modal-content" action="/rop/update_quantity" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="product_id" t-att-value="product.id"/>
                                                <div class="modal-header">
                                                    <h5 class="modal-title" t-esc="product.name"/>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                                                </div>
                                                <div class="modal-body">
                                                    <label class="form-label">New Quantity On Hand</label>
                                                    <input type="number" name="quantity" step="1" required="required"
                                                           class="form-control" t-att-value="int(product.qty_available)"/>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="submit" class="btn btn-primary">Apply</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">
                                            <a t-att-href="product.website_url or '#'"
                                               class="text-decoration-none text-reset">
                                                <t t-esc="product.name"/>
                                            </a>
                                        </h5>

                                        <div class="mt-auto pt-3">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">ROP Count</span>
                                                <strong t-esc="product.rop_count"/>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <span class="text-muted">Quantity On Hand</span>
                                                <strong t-esc="product.qty_available"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div t-else="" class="alert alert-info text-center my-5" role="alert">
                        No products currently have ROP Count less than 5.
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="rop_realtime_page" name="Real-time ROP">
        <t t-call="website.layout">
            <t t-set="additional_title">Real-time ROP</t>

            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="mb-1">Real-time ROP</h1>
                            <p class="text-muted mb-0">Products with quantity greater than 5, updated automatically</p>
                        </div>
                        <span class="badge text-bg-secondary fs-6">
                            <span id="rop_realtime_count">0</span> Product(s)
                        </span>
                    </div>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity On Hand</th>
                            </tr>
                        </thead>
                        <tbody id="rop_realtime_body"/>
                    </table>
                </section>
            </div>
        </t>
    </template>

    <template id="rop_api_page" name="ROP API">
        <t t-call="website.layout">
            <t t-set="additional_title">ROP API</t>

            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <h1 class="mb-1">ROP API</h1>
                    <p class="text-muted">Calls <code>/rop-product</code> and shows the products with quantity less than 5</p>

                    <button id="rop_api_load" type="button" class="btn btn-primary mb-3">Load products</button>
                    <span id="rop_api_status" class="ms-3 text-muted"/>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Product</th>
                                <th>Quantity On Hand</th>
                            </tr>
                        </thead>
                        <tbody id="rop_api_body"/>
                    </table>
                </section>
            </div>
        </t>
    </template>

</odoo>
